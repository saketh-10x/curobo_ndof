  <joint name="flange_mount-tool_mount" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange_mount"/>
    <child link="tool_mount"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame at sprayer TCP -->
  <link name="tool0"/>
  <joint name="tool0_mount" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0.225"/>
    <parent link="tool_mount"/>
    <child link="tool0"/>
  </joint>
